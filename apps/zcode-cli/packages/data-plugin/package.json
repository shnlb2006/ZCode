{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/data-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "data-mcp": "./dist/mcp/server.js"
  },
  "type": "module",
  "main": "./dist/mcp/server.js",
  "exports": {
    "./mcp": {
      "import": "./dist/mcp/server.js"
    }
  },
  "scripts": {
